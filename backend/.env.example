# Backend configuration. Copy to backend/.env for local runs.
# Every key is prefixed BHULEKH_ and maps to app/core/config.py:Settings.

# --- Environment ---
# development | staging | production. In production the app REFUSES to start with
# any of the insecure defaults below (weak secret, wildcard CORS/hosts, SQLite, demo seed).
BHULEKH_ENVIRONMENT=development

# --- Security / auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BHULEKH_SECRET_KEY=change-me-in-production-please
BHULEKH_ACCESS_TOKEN_EXPIRE_MINUTES=30
BHULEKH_REFRESH_TOKEN_EXPIRE_DAYS=7
BHULEKH_PASSWORD_MIN_LENGTH=10

# --- Rate limiting ---
BHULEKH_RATE_LIMIT_ENABLED=true
BHULEKH_RATE_LIMIT_DEFAULT=200/minute
BHULEKH_RATE_LIMIT_LOGIN=10/minute
BHULEKH_RATE_LIMIT_UPLOAD=30/minute

# --- HTTP hardening ---
BHULEKH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BHULEKH_TRUSTED_HOSTS=*
BHULEKH_MAX_UPLOAD_MB=25
BHULEKH_HSTS_ENABLED=false

# --- Database ---
BHULEKH_DATABASE_URL=sqlite:///./bhulekh.db
# BHULEKH_DATABASE_URL=postgresql+psycopg2://bhulekh:bhulekh@localhost:5432/bhulekh

# --- OCR ---
BHULEKH_OCR_ENGINE=tesseract
BHULEKH_OCR_LANGUAGES=eng+hin
# Only if Tesseract / its language packs are not on PATH or in the default folder:
# BHULEKH_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# BHULEKH_TESSDATA_DIR=D:\dIGITIZATIONLANFDRECORDS\tessdata   (must also contain eng.traineddata)
# BHULEKH_POPPLER_PATH=C:\poppler\Library\bin

# --- Observability ---
BHULEKH_LOG_LEVEL=INFO
BHULEKH_LOG_JSON=true
BHULEKH_SEED_DEMO_DATA=true
