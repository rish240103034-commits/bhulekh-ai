# Copy to .env in the repo root before `docker compose up --build`.
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required ---
BHULEKH_SECRET_KEY=replace-with-a-strong-random-48+char-secret
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# --- Recommended overrides ---
BHULEKH_ENVIRONMENT=production
BHULEKH_SEED_DEMO_DATA=false
# The public origin(s) the browser loads the SPA from (comma-separated, no trailing slash):
BHULEKH_CORS_ORIGINS=http://localhost:8080
# The Host header(s) the API will accept:
BHULEKH_TRUSTED_HOSTS=localhost,api
# Turn on only when the API is served over HTTPS:
BHULEKH_HSTS_ENABLED=false

# --- Optional ---
POSTGRES_USER=bhulekh
POSTGRES_DB=bhulekh
WEB_PORT=8080
BHULEKH_OCR_LANGUAGES=eng+hin
